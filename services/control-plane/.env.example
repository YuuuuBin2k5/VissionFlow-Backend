APP_ENV=local
PORT=8000
API_PREFIX=/api/v1
# Comma-separated exact browser origins. Required for Vercel refresh cookies.
VISIONFLOW_WEB_ORIGINS=https://vision-flow-console.vercel.app

# Runtime services use Neon pooled PostgreSQL. The pooler URL must include sslmode=require.
DATABASE_URL=postgresql+psycopg://visionflow_app:replace_me@your-neon-pooler-host/visionflow?sslmode=require

# Alembic runs with Neon direct PostgreSQL, never the pooled URL.
MIGRATION_DATABASE_URL=postgresql+psycopg://visionflow_migrator:replace_me@your-neon-direct-host/visionflow?sslmode=require

# Browser API access uses an external OIDC provider. Never mint or validate browser tokens with a shared secret.
OIDC_ISSUER=https://your-identity-provider.example.com/
OIDC_AUDIENCE=visionflow-control-plane
OIDC_JWKS_URL=https://your-identity-provider.example.com/.well-known/jwks.json
OIDC_ALLOWED_ALGORITHMS=RS256,ES256

# VisionFlow self-managed auth signs short-lived RS256 access tokens. Store the
# base64 encoded, unencrypted PEM in Render's secret store; never commit it.
# The public key is published by the future /auth/jwks endpoint.
VISIONFLOW_AUTH_ISSUER=https://your-control-plane.example.com
VISIONFLOW_AUTH_AUDIENCE=visionflow-control-plane
VISIONFLOW_AUTH_KEY_ID=visionflow-2026-01
VISIONFLOW_AUTH_PRIVATE_KEY_PEM_BASE64=replace_with_base64_encoded_rsa_private_key
VISIONFLOW_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# Opaque refresh credentials live only in a Secure, HttpOnly cookie and are
# rotated on every use. Keep the production lifetime within 1-90 days.
VISIONFLOW_AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Service-to-service client credentials.  Configure the same client ID and
# secret on the Control Plane and intelligence worker; the worker never needs
# the private signing key.  Bootstrap VISIONFLOW_WORKER_SUBJECT as an
# organization member before it can advance workflows.
VISIONFLOW_WORKER_CLIENT_ID=visionflow-intelligence-worker
VISIONFLOW_WORKER_CLIENT_SECRET=replace_with_a_long_random_secret
VISIONFLOW_WORKER_SUBJECT=service|visionflow-intelligence-worker

# Optional until VF-03.02b Stream B is deployed. Configure all three values
# together; this client can register a legacy-job mapping but cannot complete
# narration. Do not reuse the worker client secret or subject.
VISIONFLOW_LEGACY_MAPPING_CLIENT_ID=visionflow-legacy-intake
VISIONFLOW_LEGACY_MAPPING_CLIENT_SECRET=replace_with_a_different_long_random_secret
VISIONFLOW_LEGACY_MAPPING_SUBJECT=service|visionflow-legacy-intake
# Deprecated compatibility alias. Leave unset for new deployments.
# VISIONFLOW_INTAKE_SUBJECT=service|visionflow-legacy-intake

# Sign only visionflow.legacy_job.requested.v1 stream messages. The intake
# consumer accepts this key and its previous key during a planned rotation.
VISIONFLOW_INTAKE_HMAC_KEY_ID=2026-07
VISIONFLOW_INTAKE_HMAC_KEY=replace_with_a_long_random_hmac_key

# Dedicated Redis-compatible broker for the outbox relay. Use TLS in staging/production.
REDIS_URL=rediss://default:replace_me@your-redis-host:6379/0
VISIONFLOW_EVENTS_STREAM=visionflow.workflow-events.v1
