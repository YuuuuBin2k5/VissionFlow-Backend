# ============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO PYTHON WORKER
# ============================================================

# API Key cho Pexels để tự động tải video dọc miễn phí bản quyền
# Đăng ký miễn phí tại: https://www.pexels.com/api/
PEXELS_API_KEY=YOUR_PEXELS_API_KEY_HERE

# API Key cho Pixabay để mở rộng nguồn video/ảnh free stock
# Lưu ý: khi hiển thị kết quả tìm kiếm, nên ghi rõ nội dung đến từ Pixabay.
# API yêu cầu cache kết quả 24 giờ và không dùng để mass-download.
PIXABAY_API_KEY=YOUR_PIXABAY_API_KEY_HERE

# API Key cho Coverr, để dành cho connector Coverr khi có endpoint API chính thức
COVERR_API_KEY=YOUR_COVERR_API_KEY_HERE

# API Key cho Gemini AI để tự động lập chiến dịch và viết kịch bản
# Đăng ký miễn phí tại Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Cấu hình kết nối MySQL Database (Phải khớp với Orchestrator và Docker)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_NAME=tiktok_agent_automation_db

# Lịch đăng TikTok an toàn
# office_student = 11:30 và 19:30; deep_night = 12:00 và 22:00
SCHEDULE_TIMEZONE=Asia/Bangkok
POSTING_SCHEDULE_PRESET=office_student
MIN_HOURS_BETWEEN_POSTS=4

# Render engine
# classic = pipeline giáo dục/TTS/MoviePy hiện tại
# music_reactive = pipeline V2 audio-reactive Canvas/Playwright/FFmpeg
RENDER_ENGINE=classic
REACTIVE_RENDER_FPS=24
REACTIVE_RENDER_WIDTH=1080
REACTIVE_RENDER_HEIGHT=1920
REACTIVE_MIN_FILE_SIZE_MB=2

# Remix audio hợp lệ/trending-safe trước khi render audio-reactive
REMIX_BASS_GAIN=0.22
REMIX_DRUM_GAIN=0.16
REMIX_STYLE=trend_bass
REMIX_REQUIRE_RIGHTS_CONFIRMATION=true

# Browser runtime
# Oracle Ampere A1 is ARM64, so leave BROWSER_CHANNEL empty by default.
# Use bundled Playwright Chromium, or set BROWSER_EXECUTABLE_PATH=/usr/bin/chromium-browser.
BROWSER_CHANNEL=
BROWSER_EXECUTABLE_PATH=
BROWSER_EXTRA_ARGS=

# VisionFlow Control Plane: new worker path.  The worker exchanges its
# client credentials against the Control Plane's internal `/auth/token` route.
# Bootstrap VISIONFLOW_WORKER_SUBJECT with `--role service`; never expose this
# secret outside the worker process.
VISIONFLOW_CONTROL_PLANE_URL=https://your-control-plane.example.com/api/v1
VISIONFLOW_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
VISIONFLOW_TOKEN_URL=https://your-control-plane.example.com/api/v1/auth/token
VISIONFLOW_WORKER_CLIENT_ID=visionflow-intelligence-worker
VISIONFLOW_WORKER_CLIENT_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE
VISIONFLOW_AUTH_AUDIENCE=visionflow-control-plane
REDIS_URL=rediss://default:replace_me@your-redis-host:6379/0
VISIONFLOW_EVENTS_STREAM=visionflow.workflow-events.v1
VISIONFLOW_WORKER_GROUP=visionflow-intelligence-v1
VISIONFLOW_WORKER_CONSUMER=worker-1
# Run as a distinct Render Worker process: python consume_visionflow_events.py

# S3-compatible storage: Cloudflare R2 (recommended) or AWS S3. Never expose these in the browser.
VISIONFLOW_OBJECT_STORE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
VISIONFLOW_OBJECT_STORE_BUCKET=visionflow-assets
VISIONFLOW_OBJECT_STORE_ACCESS_KEY_ID=replace_me
VISIONFLOW_OBJECT_STORE_SECRET_ACCESS_KEY=replace_me
VISIONFLOW_OBJECT_STORE_REGION=auto
