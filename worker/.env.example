# ============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO PYTHON WORKER
# ============================================================

# API Key cho Pexels để tự động tải video dọc miễn phí bản quyền
# Đăng ký miễn phí tại: https://www.pexels.com/api/
PEXELS_API_KEY=YOUR_PEXELS_API_KEY_HERE

# API Key cho Gemini AI để tự động lập chiến dịch và viết kịch bản
# Đăng ký miễn phí tại Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Cấu hình kết nối MySQL Database (Phải khớp với Orchestrator và Docker)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_NAME=tiktok_agent_automation_db

# Lịch đăng TikTok an toàn
# office_student = 11:30 và 19:30; deep_night = 12:00 và 22:00
SCHEDULE_TIMEZONE=Asia/Bangkok
POSTING_SCHEDULE_PRESET=office_student
MIN_HOURS_BETWEEN_POSTS=4

# Render engine
# classic = pipeline giáo dục/TTS/MoviePy hiện tại
# music_reactive = pipeline V2 audio-reactive Canvas/Playwright/FFmpeg
RENDER_ENGINE=classic
REACTIVE_RENDER_FPS=24
REACTIVE_RENDER_WIDTH=1080
REACTIVE_RENDER_HEIGHT=1920
REACTIVE_MIN_FILE_SIZE_MB=2

# Remix audio hợp lệ/trending-safe trước khi render audio-reactive
REMIX_BASS_GAIN=0.22
REMIX_DRUM_GAIN=0.16
REMIX_STYLE=trend_bass
REMIX_REQUIRE_RIGHTS_CONFIRMATION=true
