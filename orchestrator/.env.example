# ============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO NESTJS ORCHESTRATOR
# ============================================================

# 1. DATABASE CONFIGURATION (MySQL Docker Container)
# Mẫu kết nối: mysql://[User]:[Password]@[Host]:[Port]/[Database]
DATABASE_URL="mysql://root:YOUR_DB_PASSWORD_HERE@localhost:3307/tiktok_agent_automation_db"

# 2. REDIS CONFIGURATION (Redis Docker Container)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6380
REDIS_URL="redis://127.0.0.1:6380"

# 3. TELEGRAM BOT CONFIGURATION
# Tạo bot qua @BotFather trên Telegram và copy token dán vào đây
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"
YOUTUBE_TELEGRAM_BOT_TOKEN="YOUR_YOUTUBE_TELEGRAM_BOT_TOKEN_HERE"
YOUTUBE_SECOND_TELEGRAM_BOT_TOKEN="YOUR_YOUTUBE_SECOND_TELEGRAM_BOT_TOKEN_HERE"
TELEGRAM_HANDLER_TIMEOUT_MS=600000

# 4. AI INTENT ROUTER
# Optional: nếu không có key, bot vẫn hiểu các câu phổ biến bằng rule-based fallback.
# Hỗ trợ cấu hình nhiều API Key cách nhau bằng dấu phẩy để tự động xoay vòng (Key Rotation) khi gặp lỗi quá hạn ngạch (HTTP 429).
# Ví dụ: GEMINI_API_KEY="AIzaSyA...,AIzaSyB...,AIzaSyC..."
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 5. SERVER PORT
PORT=3000

# Secret used to encrypt per-user OAuth tokens/API keys in database.
# Generate a long random value and never commit the real value.
APP_SECRET_ENCRYPTION_KEY="GENERATE_A_LONG_RANDOM_SECRET_HERE"

# 6. SAFE TIKTOK POSTING SCHEDULE
# Default preset posts at 11:30 and 19:30, Asia/Bangkok time.
SCHEDULE_TIMEZONE="Asia/Bangkok"
POSTING_SCHEDULE_PRESET="office_student"
MIN_HOURS_BETWEEN_POSTS=4

# 7. RENDER ENGINE
RENDER_ENGINE="classic"

# 8. REMIX CONTROL
REMIX_STYLE="trend_bass"
REMIX_REQUIRE_RIGHTS_CONFIRMATION=true

# 9. YOUTUBE API / OAUTH
YOUTUBE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
YOUTUBE_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
YOUTUBE_REDIRECT_URI="http://localhost:3000/oauth2callback"
# Optional legacy single-channel token. Multi-user mode stores user refresh tokens encrypted in DB.
YOUTUBE_REFRESH_TOKEN="YOUR_YOUTUBE_REFRESH_TOKEN"
YOUTUBE_DEFAULT_PRIVACY_STATUS="public"
