# Copy this to orchestrator/.env on the server and fill real values.

NODE_ENV="production"
PORT=3000

DATABASE_URL="mysql://root:CHANGE_ME@127.0.0.1:3307/tiktok_agent_automation_db"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6380
REDIS_URL="redis://127.0.0.1:6380"

TELEGRAM_BOT_TOKEN="CHANGE_ME"
YOUTUBE_TELEGRAM_BOT_TOKEN="CHANGE_ME"

GEMINI_API_KEY="CHANGE_ME"

APP_SECRET_ENCRYPTION_KEY="CHANGE_ME_LONG_RANDOM_SECRET"

SCHEDULE_TIMEZONE="Asia/Bangkok"
POSTING_SCHEDULE_PRESET="office_student"
MIN_HOURS_BETWEEN_POSTS=4

RENDER_ENGINE="classic"
REMIX_STYLE="trend_bass"
REMIX_REQUIRE_RIGHTS_CONFIRMATION=true

YOUTUBE_CLIENT_ID="CHANGE_ME"
YOUTUBE_CLIENT_SECRET="CHANGE_ME"
YOUTUBE_REDIRECT_URI="https://your-domain.com/oauth2callback"
YOUTUBE_DEFAULT_PRIVACY_STATUS="public"

# Optional legacy single-channel fallback. Multi-user mode should connect users through /connect_youtube.
YOUTUBE_REFRESH_TOKEN=""
